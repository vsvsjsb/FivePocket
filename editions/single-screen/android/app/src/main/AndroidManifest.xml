<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:required="false"
        android:version="0x00400003" />
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:required="false"
        android:version="1" />

    <!-- One permission, VIBRATE (Update 1, Vibration: the game's rumble on this device's motor). Android grants it at
         install without asking; it allows nothing but the vibration motor. Nothing else is requested: the app reads the
         player's two disc images through the system file chooser, writes the game's files only to its own private storage,
         and copies captures to the shared Pictures folder through the media store (which needs no permission from Android 10
         on). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Every screen handles a change of the "navigation" configuration itself, as it handles "keyboard": a controller
         that Android counts as a D-pad changes it when it connects or goes, and Android would otherwise make the
         window anew. The game window ends the game's process when it is stopped, so that would end the game. -->
    <application
        android:name=".ShipApplication"
        android:appCategory="game"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">
        <!-- 2026-10-25 (owner: "speed hacks ... forcing it to use game mode ... do it yourself"): a game for Android's game
             manager, opted in to its performance mode; no OS downscaling or frame-rate override (the app paces itself). -->
        <meta-data android:name="android.game_mode_config" android:resource="@xml/game_mode_config" />
        <!-- The first screen. In a build that carries its game code it puts that code in place (first start and
             after every update) and then opens the menu; it asks nothing. In a build without game code inside it
             opens the menu at once. -->
        <activity
            android:name=".ShipStartActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The menu (and, by intent extra, the graphics self-test). Still exported so that an explicit start
             by component name keeps working; it no longer carries the launcher category. fontScale: a change of
             the system's font size is handled in place (the menu stays on its tab, a disc copy keeps running). -->
        <activity
            android:name=".BootstrapActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|fontScale"
            android:exported="true"
            android:screenOrientation="sensorLandscape" />
        <!-- The game window and the controller check, in every build type since ship week. A separate process
             keeps their limits and crashes out of the menu, and its name is the single-instance rule the
             loader checks. Not exported: only this app's own menu starts them. The debug build type exports
             them again for the measurement scripts (src/debug/AndroidManifest.xml). -->
        <activity
            android:name=".ControllerCheckActivity"
            android:process=":private_trace"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|fontScale"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name=".PrivateTraceActivity"
            android:process=":private_trace"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name=".GpuDriverImportActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />
        <!-- Update 1 P6 My Music: copies the player's songs into the app's music folder (files/My Music in its external files
             directory). Exported only to receive songs shared from a file manager (audio/*); it reads content from local storage
             providers only and opens no network connection. Started without songs it only says how to add them.
             Update 1: disabled (not in the share sheet) until E-SR1 passes; see MyMusicSettings.SHOWN. -->
        <activity
            android:name=".MyMusicImportActivity"
            android:enabled="false"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Add to My Music"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
